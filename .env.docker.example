# 生成方式示例：openssl rand -base64 48 | tr -d "\n"
ASSISTANT_INTERNAL_TOKEN=replace-with-32-or-more-random-characters
ASSISTANT_USER_CONTEXT_SECRET=replace-with-an-independent-32-character-secret
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password
EXPOSE_DEMO_CODE=false

# 报名死信：可恢复错误有限次数自动重放；转人工后推送到下面的 Webhook。
REGISTRATION_DLQ_AUTO_RETRY_ENABLED=true
REGISTRATION_DLQ_AUTO_RETRY_MAX_ATTEMPTS=3
REGISTRATION_DLQ_AUTO_RETRY_FAILURE_CODES=RETRY_EXHAUSTED
REGISTRATION_DLQ_ALERT_WEBHOOK_URL=

# 不配置模型时使用规则模式；配置后启用 LLM Agent。
ASSISTANT_MODEL_BASE_URL=
ASSISTANT_MODEL_API_KEY=
ASSISTANT_MODEL_NAME=
ASSISTANT_MODEL_TIMEOUT_SECONDS=12
